# CAP ANALYSIS PIPELINE (Complete Final Version with Local Baseline)
# Objective: Automate the extraction, alignment, interpolation,
# and quantification of Compound Action Potentials (N1 and N2)
# from raw electrophysiological recordings (.abf files).

# CONFIGURATION
# Objective: Set up file paths, target experiments, and physical parameters.
file_name = '00059.abf'  # Switch to '00062.abf' or '00063.abf' as needed
file_path = f'/content/drive/MyDrive/Caps_Analysis/{file_name}'
electrode_distance_mm = 11.0  # Distance between stimulating and recording electrodes in mm

if not os.path.exists(file_path):
    raise FileNotFoundError(f"Could not find file at: {file_path}")

print(f"-> Loading file: {file_name}")
reader = neo.io.AxonIO(filename=file_path)
block = reader.read_block(lazy=False)

# 1. NATIVE SEGMENT EXTRACTION AND ALIGNMENT
# Objective: Isolate individual stimulation sweeps from the continuous recording
# and temporally align them to the stimulus artifact to ensure phase-locking.
pre_stim_ms = 5.0
post_stim_ms = 45.0
aligned_epochs = []
sampling_rate = None

for seg in block.segments:
    if len(seg.analogsignals) > 0:
        sig = seg.analogsignals[0]
        sampling_rate = float(sig.sampling_rate.rescale('Hz').magnitude)
        data = np.ravel(sig[:, 0].magnitude)

        pre_pts = int((pre_stim_ms / 1000.0) * sampling_rate)
        post_pts = int((post_stim_ms / 1000.0) * sampling_rate)

        search_window_pts = int((20.0 / 1000.0) * sampling_rate)
        if len(data) >= search_window_pts:
            local_stim_idx = np.argmax(np.abs(data[:search_window_pts]))
            epoch_start = local_stim_idx - pre_pts
            epoch_end = local_stim_idx + post_pts

            if epoch_start >= 0 and epoch_end <= len(data):
                aligned_epochs.append(data[epoch_start:epoch_end])

if len(aligned_epochs) == 0:
    sig = block.segments[0].analogsignals[0]
    voltage_stream = np.ravel(sig[:, 0].magnitude)
    sampling_rate = float(sig.sampling_rate.rescale('Hz').magnitude)
    sweep_duration_ms = 1000.0
    points_per_sweep = int((sweep_duration_ms / 1000.0) * sampling_rate)
    total_sweeps = len(voltage_stream) // points_per_sweep
    pre_pts = int((pre_stim_ms / 1000.0) * sampling_rate)
    post_pts = int((post_stim_ms / 1000.0) * sampling_rate)

    for i in range(total_sweeps):
        start_idx = i * points_per_sweep
        end_idx = start_idx + points_per_sweep
        chunk = voltage_stream[start_idx:end_idx]
        local_stim_idx = np.argmax(np.abs(chunk[:int((20.0/1000.0)*sampling_rate)]))
        abs_stim_idx = start_idx + local_stim_idx
        epoch_start = abs_stim_idx - pre_pts
        epoch_end = abs_stim_idx + post_pts
        if epoch_start >= 0 and epoch_end <= len(voltage_stream):
            aligned_epochs.append(np.ravel(voltage_stream[epoch_start:epoch_end]))

stacked_epochs = np.vstack(aligned_epochs)
voltage_raw = np.ravel(np.mean(stacked_epochs, axis=0))
time = np.ravel((np.arange(len(voltage_raw)) - pre_pts) / sampling_rate * 1000.0)

print(f"-> Successfully processed {len(aligned_epochs)} sweeps for {file_name}!")

# 2. BASELINE CORRECTION & UNIT CONVERSION (uV to mV)
# Objective: Level the pre-stimulus baseline to 0 mV (using the -5 to -0.5 ms window)
# and convert raw microvolts into standard millivolts.
baseline_mask = (time >= -5.0) & (time < -0.5)
voltage_corrected = voltage_raw - np.mean(voltage_raw[baseline_mask])
voltage_corrected_mv = voltage_corrected / 1000.0

# 3. CUBIC SPLINE INTERPOLATION & PEAK DETECTION
# Objective: Overcome the rigid digital timing grid of the hardware (20 kHz)
# by fitting a smooth cubic spline curve to resolve sub-millisecond latencies.
time_fine = np.linspace(time[0], time[-1], len(time) * 10)
cs = CubicSpline(time, voltage_corrected_mv)
voltage_fine = cs(time_fine)

# N1 Peak Detection (Fine Grid): Fast-conducting myelinated fibers (Aα/β)
n1_window = (0.12, 0.35)
n1_mask = (time_fine >= n1_window[0]) & (time_fine <= n1_window[1])
t_fine_n1 = time_fine[n1_mask]
v_fine_n1 = voltage_fine[n1_mask]

n1_best_idx = np.argmin(v_fine_n1)
t_n1 = float(t_fine_n1[n1_best_idx])
v_n1 = float(v_fine_n1[n1_best_idx])

# N2 Peak Detection (Fine Grid): Slower-conducting fibers (Aδ)
n2_window = (t_n1 + 0.15, t_n1 + 0.60)
n2_mask = (time_fine >= n2_window[0]) & (time_fine <= n2_window[1])
if np.any(n2_mask):
    t_fine_n2 = time_fine[n2_mask]
    v_fine_n2 = voltage_fine[n2_mask]
    n2_best_idx = np.argmin(v_fine_n2)
    t_n2 = float(t_fine_n2[n2_best_idx])
    v_n2 = float(v_fine_n2[n2_best_idx])
else:
    t_n2, v_n2 = t_n1 + 0.30, 0.0

# Calculate Conduction Velocity (CV = distance / latency)
cv_n1 = electrode_distance_mm / t_n1 if t_n1 > 0 else 0.0
cv_n2 = electrode_distance_mm / t_n2 if t_n2 > 0 else 0.0

print(f"\n--- Interpolated Results for {file_name} ---")
print(f"N1 Latency: {t_n1:.3f} ms | Amplitude: {v_n1:.3f} mV | CV: {cv_n1:.2f} m/s")
print(f"N2 Latency: {t_n2:.3f} ms | Amplitude: {v_n2:.3f} mV | CV: {cv_n2:.2f} m/s")

