# Objective: Programmatically define physiological start/end shoulders for each peak,
# construct a local baseline chord, and compute precise Area Under the Curve (AUC) using Simpson's rule (integrating)

# N1 Dynamic Bounds & Chord Baseline (Artifact-safe clamping)
safe_n1_start = 0.125
left_bound_n1 = max(safe_n1_start, t_n1 - 0.07)

search_n1_right = (time_fine >= t_n1) & (time_fine <= t_n1 + 0.25)
right_bound_n1 = time_fine[search_n1_right][np.argmax(voltage_fine[search_n1_right])] if np.any(search_n1_right) else t_n1 + 0.05

mask_fine_n1 = (time_fine >= left_bound_n1) & (time_fine <= right_bound_n1)
x_fine_n1 = time_fine[mask_fine_n1]
y_fine_n1 = voltage_fine[mask_fine_n1]

v_left_n1 = voltage_fine[np.argmin(np.abs(time_fine - left_bound_n1))]
v_right_n1 = voltage_fine[np.argmin(np.abs(time_fine - right_bound_n1))]
baseline_n1 = np.linspace(v_left_n1, v_right_n1, len(x_fine_n1))
auc_n1 = float(simpson(baseline_n1 - y_fine_n1, x=x_fine_n1))

# N2 Adaptive Shoulder-to-shoulder Bounds & Chord Baseline
search_n2_left = (time_fine >= t_n1 + 0.05) & (time_fine <= t_n2)
if np.any(search_n2_left):
    left_bound_n2 = time_fine[search_n2_left][np.argmax(voltage_fine[search_n2_left])]
else:
    left_bound_n2 = t_n1 + 0.15

search_n2_right = (time_fine >= t_n2) & (time_fine <= t_n2 + 0.25)
if np.any(search_n2_right):
    right_bound_n2 = time_fine[search_n2_right][np.argmax(voltage_fine[search_n2_right])]
else:
    right_bound_n2 = t_n2 + 0.15

mask_fine_n2 = (time_fine >= left_bound_n2) & (time_fine <= right_bound_n2)
x_fine_n2 = time_fine[mask_fine_n2]
y_fine_n2 = voltage_fine[mask_fine_n2]

v_left_n2 = voltage_fine[np.argmin(np.abs(time_fine - left_bound_n2))]
v_right_n2 = voltage_fine[np.argmin(np.abs(time_fine - right_bound_n2))]
baseline_n2 = np.linspace(v_left_n2, v_right_n2, len(x_fine_n2))
auc_n2 = float(simpson(baseline_n2 - y_fine_n2, x=x_fine_n2))

print(f"N1 AUC: {auc_n1:.4f} mV·ms")
print(f"N2 AUC: {auc_n2:.4f} mV·ms")

import plotly.graph_objects as go

